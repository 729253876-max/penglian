{
  "name": "photo-ai-miniprogram",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "pretest": "npm run config:local -w @photo-ai/miniprogram",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev -w @photo-ai/api",
    "verify:miniprogram-runtime": "npm run verify:runtime -w @photo-ai/miniprogram"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
