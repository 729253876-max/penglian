.live { padding-top: 56rpx; }.live-label { color: #6c58c9; font-family: "DIN Alternate", sans-serif; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; }.live-title { margin: 12rpx 0; font-size: 46rpx; font-weight: 800; }.stream { margin: 40rpx 0; }.event-row { display: flex; min-height: 106rpx; }.track { position: relative; width: 48rpx; flex: 0 0 48rpx; }.track-dot { position: absolute; z-index: 1; top: 10rpx; left: 9rpx; width: 18rpx; height: 18rpx; border: 5rpx solid #f7f5f0; border-radius: 50%; background: #6c58c9; box-shadow: 0 0 0 2rpx #6c58c9; }.track-line { position: absolute; top: 36rpx; bottom: -6rpx; left: 19rpx; width: 2rpx; background: #c8bddf; }.event-row:last-child .track-line { display: none; }.event-copy { flex: 1; padding: 0 0 30rpx 18rpx; font-size: 27rpx; line-height: 1.55; }.event-meta { margin-bottom: 7rpx; color: #6c58c9; font-family: "DIN Alternate", sans-serif; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }.working { display: flex; align-items: flex-start; gap: 16rpx; color: #77727f; font-size: 24rpx; line-height: 1.6; }.pulse { width: 18rpx; height: 18rpx; flex: 0 0 18rpx; margin-top: 8rpx; border-radius: 50%; background: #d8a45d; animation: pulse 1.2s infinite; }.error { margin-top: 24rpx; color: #a4464c; line-height: 1.6; }.retry { margin: 18rpx 0 0; color: #fff; background: #a4464c; font-size: 26rpx; }.button-primary { margin-top: 30rpx; } @keyframes pulse { 50% { transform: scale(.65); opacity: .45; } }
