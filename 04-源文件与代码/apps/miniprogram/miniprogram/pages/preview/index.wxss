.preview { position: relative; padding: 0; overflow: hidden; }.preview-image { display: block; width: 100%; height: 760rpx; background: #d8cec6; }.preview-tag { position: absolute; top: 24rpx; left: 24rpx; padding: 10rpx 18rpx; border-radius: 999rpx; color: #fff; background: rgba(23,23,25,.62); font-family: "DIN Alternate", sans-serif; font-size: 22rpx; }.film-note { position: absolute; right: 22rpx; bottom: 20rpx; color: #fff; font-family: "DIN Alternate", sans-serif; font-size: 19rpx; letter-spacing: 1rpx; }.compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 24rpx 0; }.compare button { border-radius: 20rpx; color: #5d5862; background: #ece8e2; font-size: 27rpx; }.compare button.active { color: #fff; background: #6c58c9; }.notice { margin-bottom: 24rpx; }.notice-title { margin-bottom: 10rpx; font-size: 30rpx; font-weight: 750; }
