<view class="page">
  <view wx:if="{{!taskId}}" class="preview card">
    <view class="demo-boundary">产品示例 / 非真实用户结果</view>
    <image src="/assets/demo-after.svg" aria-label="产品示例精修效果，非真实用户结果，不代表供应商质量" />
    <image src="/assets/demo-before.svg" aria-label="产品示例原图，非真实用户照片" />
  </view>
  <view wx:if="{{canPreview}}" class="preview card" aria-label="原图安全占位和真实任务水印预览的可拖动比较">
    <view class="demo-boundary">真实任务结果 · 原图使用安全占位</view>
    <view class="preview-stage">
      <image class="preview-image preview-after" src="{{previewUrl}}" mode="aspectFill" aria-label="真实任务生成的水印预览" />
      <view class="before-mask" style="width: {{comparePercent}}%;">
        <image class="preview-image preview-before" src="{{originalPlaceholder}}" mode="aspectFill" aria-label="原图安全缩略图占位，不请求永久存储地址" />
      </view>
      <view class="compare-divider" style="left: {{comparePercent}}%;" aria-hidden="true"></view>
      <view class="preview-tag original-tag">原图</view>
      <view class="preview-tag retouched-tag">精修后 · 水印预览</view>
    </view>
    <view class="comparison-controls">
      <view class="comparison-labels" aria-hidden="true">
        <text>原图</text>
        <text>精修后</text>
      </view>
      <slider min="0" max="100" value="{{comparePercent}}" activeColor="#6c58c9" backgroundColor="#ded9d1" bindchanging="setComparison" bindchange="setComparison" aria-label="拖动比较原图和精修后水印预览" />
    </view>
  </view>

  <view class="card identity-note" aria-label="精修保留范围">
    <view class="notice-title">尽量保留本人、姿势和构图</view>
    <view class="muted">只针对光线、暗部和肤质层次做自然修复，不改变人物身份与照片表达。</view>
  </view>

  <view class="card notice" aria-label="水印预览说明">
    <view class="notice-title">水印预览不可保存</view>
    <view class="muted">这是效果确认用预览，不能保存或导出。你可以返回调整精修方向后再次查看。</view>
  </view>

  <button class="button-primary" bindtap="adjustAgain">返回调整方向</button>
  <button class="trace-link" bindtap="viewFullTrace">查看完整修复记录</button>

  <view class="details card">
    <button class="details-toggle" bindtap="toggleDetails" aria-expanded="{{showDetails}}">{{showDetails ? '收起精修详情' : '查看精修详情'}}</button>
    <view wx:if="{{showDetails}}" class="details-copy"><view wx:for="{{trace}}" wx:key="eventId">SEQ {{item.sequence}} · {{item.evidenceLabel}} · {{item.text}}</view></view>
  </view>
</view>
