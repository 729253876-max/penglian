.home { padding-top: 64rpx; }
.eyebrow { color: #6c58c9; font-family: "DIN Alternate", sans-serif; font-size: 21rpx; font-weight: 700; letter-spacing: 1rpx; }
.title { margin-top: 12rpx; font-size: 56rpx; font-weight: 800; letter-spacing: -2rpx; }
.subtitle { margin-top: 16rpx; color: #716d76; font-size: 28rpx; line-height: 1.6; }
.hero { margin-top: 40rpx; padding: 0; overflow: hidden; }
.photo-frame { position: relative; }
.hero-image { display: block; width: 100%; height: 520rpx; background: #ddd3cc; }
.edge-mark { position: absolute; left: 22rpx; color: #fff; font-family: "DIN Alternate", sans-serif; font-size: 20rpx; letter-spacing: 1rpx; text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .35); }
.edge-mark.top { top: 20rpx; }
.edge-mark.bottom { bottom: 20rpx; }
.hero-copy { padding: 28rpx; }
.hero-name { margin-bottom: 8rpx; font-size: 34rpx; font-weight: 750; }
.hero .button-primary { margin-top: 28rpx; }
.button-secondary { margin-top: 16rpx; border: 1rpx solid #171719; border-radius: 28rpx; background: #fff; color: #171719; font-size: 30rpx; font-weight: 700; }
.scenario-heading { margin-top: 40rpx; font-size: 32rpx; font-weight: 750; }
.scenario-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 20rpx; }
.scenario-card { border-radius: 24rpx; padding: 28rpx; background: #ece8e2; }
.scenario-card:nth-child(2) { background: #dce9e4; }
.scenario-card.disabled { opacity: .7; }
.tool-name { margin-bottom: 6rpx; font-size: 28rpx; font-weight: 700; }
