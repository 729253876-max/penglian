<view class="page home">
  <view class="eyebrow">IMPORTANT PHOTO RESCUE</view>
  <view class="title" role="heading" aria-level="1">这张重要照片，还能救得更好。</view>
  <view class="subtitle">尽量保留本人、姿势和构图，先看预览，满意再解锁。</view>

  <view class="hero card">
    <view class="photo-frame">
      <image class="hero-image" src="/assets/demo-before.svg" mode="aspectFill" aria-label="示例旅行人像原图"/>
      <view class="edge-mark top">DEMO · BEFORE</view>
      <view class="edge-mark bottom">示例照片 / 旅行人像</view>
    </view>
    <view class="hero-copy">
      <view class="hero-name">旅行人像救片示例</view>
      <view class="muted">脸暗、逆光或肤色不自然，也能保留真实的你。</view>
      <button class="button-primary" bindtap="startPortraitDemo">使用示例体验救片</button>
      <button class="button-secondary" bindtap="openDemoCase">先看同图示例</button>
    </view>
  </view>

  <view class="scenario-heading" role="heading" aria-level="2">你想救回哪种遗憾？</view>
  <view class="scenario-grid">
    <block wx:for="{{scenarios}}" wx:key="id">
      <view wx:if="{{item.availableInDemo}}" class="scenario-card">
        <view class="tool-name">{{item.title}}</view>
        <view class="muted">{{item.problem}} · 已提供示例体验</view>
      </view>
      <view wx:else class="scenario-card disabled" aria-disabled="true">
        <view class="tool-name">{{item.title}}</view>
        <view class="muted">{{item.problem}}</view>
      </view>
    </block>
  </view>
</view>
