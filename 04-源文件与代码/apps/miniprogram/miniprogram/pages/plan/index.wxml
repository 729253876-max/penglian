<view class="page">
  <view class="plan-photo card">
    <view class="demo-boundary">产品示例 / 非真实用户结果</view>
    <image src="/assets/demo-before.svg" mode="aspectFill" aria-label="产品示例原图，非真实用户照片或分析结果"/>
    <view class="photo-note">EXPOSURE NOTE · SHADOW RECOVERY</view>
  </view>
  <view wx:for="{{plans}}" wx:key="direction" class="card plan {{selectedDirection === item.direction ? 'is-selected' : ''}}" data-direction="{{item.direction}}" bindtap="selectDirection">
    <view wx:if="{{item.recommended}}" class="badge">AI 默认推荐</view>
    <view class="plan-title">{{item.title}}</view>
    <view class="muted">自然度 {{item.naturalness}} · 细节 {{item.detailLevel}}</view>
    <view wx:if="{{item.warning}}" class="warning">{{item.warning}}</view>
    <view class="boundary-title">完整保护</view>
    <view class="promise"><view wx:for="{{item.protections}}" wx:key="*this">✓ {{item}}</view></view>
    <view class="boundary-title">禁止操作</view>
    <view class="forbidden"><view wx:for="{{item.forbiddenOperations}}" wx:key="*this">— {{item}}</view></view>
  </view>
  <view class="card action-card">
    <button class="button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="startPreview">开始生成水印预览</button>
    <view wx:if="{{submitting}}" class="status">正在创建精修任务，请勿重复提交。</view>
    <view wx:if="{{error}}" class="error">{{error}}<view class="error-hint">检查本地 API 后，再次点击“开始生成水印预览”。</view></view>
  </view>
</view>
