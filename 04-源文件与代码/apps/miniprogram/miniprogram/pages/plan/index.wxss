.plan-photo { position: relative; padding: 0; overflow: hidden; }.plan-photo image { display: block; width: 100%; height: 480rpx; }.demo-boundary { position: absolute; z-index: 1; top: 20rpx; left: 20rpx; padding: 10rpx 16rpx; border-radius: 999rpx; color: #fff; background: rgba(23, 23, 25, .72); font-size: 21rpx; font-weight: 700; }.photo-note { position: absolute; right: 20rpx; bottom: 18rpx; color: #fff; font-family: "DIN Alternate", sans-serif; font-size: 19rpx; letter-spacing: 1rpx; }.plan { margin-top: 24rpx; }.badge { display: inline-block; padding: 10rpx 18rpx; border-radius: 999rpx; color: #5744b2; background: #eeeaff; font-family: "DIN Alternate", sans-serif; font-size: 22rpx; font-weight: 700; }.plan-title { margin: 22rpx 0 10rpx; font-size: 40rpx; font-weight: 800; }.promise { display: grid; gap: 14rpx; margin: 28rpx 0; font-size: 26rpx; line-height: 1.5; }.status { margin-top: 18rpx; color: #6c58c9; font-size: 24rpx; }.error { margin-top: 20rpx; color: #a4464c; font-size: 24rpx; line-height: 1.6; }.error-hint { margin-top: 6rpx; color: #77727f; }
