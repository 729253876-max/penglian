{
  "name": "@photo-ai/miniprogram",
  "private": true,
  "scripts": {
    "config:local": "node scripts/generate-runtime-config.cjs --local",
    "config:from-env": "node scripts/generate-runtime-config.cjs --from-env",
    "config:ensure": "node scripts/generate-runtime-config.cjs --ensure",
    "pretest": "npm run config:local",
    "pretypecheck": "npm run config:local",
    "prebuild:wechat": "npm run config:ensure",
    "prebuild:runtime-verify": "npm run config:local",
    "build:wechat": "tsc -p tsconfig.wechat.json",
    "build:wechat:configured": "npm run config:from-env && npm run build:wechat",
    "build:runtime-verify": "tsc -p tsconfig.runtime.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:runtime": "npm run build:runtime-verify && node scripts/verify-runtime.cjs"
  },
  "devDependencies": {
    "@photo-ai/contracts": "*",
    "miniprogram-api-typings": "^4.0.0"
  }
}
